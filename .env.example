# Copy to .env.local and fill in from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override the OpenSkiMap API base URL
# EXPO_PUBLIC_OPENSKIMAP_API_URL=https://api.openskimap.org

# Required only for Android release builds (Google Maps SDK)
# GOOGLE_MAPS_ANDROID_API_KEY=

# Optional: web map tiles (defaults to public OpenStreetMap tiles)
# EXPO_PUBLIC_WEB_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
